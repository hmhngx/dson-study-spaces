SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Must match front-end INTERNAL_API_SECRET (INTERNAL_API_KEY alias also works)
INTERNAL_API_SECRET=your-shared-secret

# Auth for POST /api/professors/sync (legacy)
INTERNAL_CRON_SECRET=your-cron-secret

PORT=3002

# Optional: one extra CORS origin beyond localhost + *.vercel.app
# ALLOWED_ORIGIN_EXTRA=https://your-staging.example.com

# Optional: only if adding direct Postgres from this process — transaction pooler required
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
