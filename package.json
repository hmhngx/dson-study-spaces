{
  "name": "dickinson-study-spaces",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "front-end",
    "back-end",
    "crawler"
  ],
  "scripts": {
    "dev": "npm run dev -w front-end",
    "build": "npm run build -w front-end",
    "start": "npm run start -w front-end",
    "lint": "npm run lint -w front-end",
    "dev:api": "npm run dev -w back-end",
    "start:api": "npm run start -w back-end"
  },
  "overrides": {
    "axios": "1.8.3",
    "dotenv": "16.4.7"
  }
}
